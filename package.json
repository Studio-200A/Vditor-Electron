{
  "name": "vditor-electron",
  "productName": "Vditor Desktop",
  "version": "0.1.0",
  "description": "Vditor Markdown Editor wrapped as Electron desktop application",
  "main": "dist/main/index.js",
  "scripts": {
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint src scripts tests *.config.*",
    "typecheck": "tsc -p tsconfig.main.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "check:all": "npm run check && npm run test:e2e",
    "build:main": "tsc -p tsconfig.main.json",
    "build:assets": "node scripts/copy-vditor-assets.js",
    "build": "npm run build:main && npm run build:assets",
    "start": "npm run build && electron .",
    "dev": "npm run build:assets && npm run build:main && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "vditor": "^3.11.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.0.0",
    "electron": "^42.3.0",
    "electron-builder": "^25.1.8",
    "eslint": "^10.8.1",
    "globals": "^17.10.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.vditor.desktop",
    "productName": "Vditor Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "static/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Office"
    }
  },
  "allowScripts": {
    "electron@42.3.0": true
  }
}
