#!/bin/sh
set -eu

if [ -z "${APPDIR:-}" ]; then
  APPDIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
fi

export PATH="$APPDIR/usr/bin${PATH:+:$PATH}"
export LD_LIBRARY_PATH="$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export XDG_DATA_DIRS="$APPDIR/usr/share${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}"

set -- "$@"
if command -v unshare >/dev/null 2>&1 && unshare -Ur true >/dev/null 2>&1; then
  exec "$APPDIR/usr/lib/vditor-desktop/vditor-desktop" "$@"
fi

for argument in "$@"; do
  if [ "$argument" = "--no-sandbox" ]; then
    exec "$APPDIR/usr/lib/vditor-desktop/vditor-desktop" "$@"
  fi
done

exec "$APPDIR/usr/lib/vditor-desktop/vditor-desktop" --no-sandbox "$@"
